{
  "name": "aladdin-dify",
  "version": "0.5.0-beta.2",
  "description": "Wei Biran's FDE delivery toolkit for Dify: an OpenCode harness with a browser UI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aladdin-dify": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md"
  ],
  "scripts": {
    "start": "node dist/cli.mjs",
    "dev": "npm run compile && npm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run compile && npm test",
    "test:engine": "node scripts/test-engine.mjs",
    "format": "prettier --write src test scripts docs examples *.json *.md .github",
    "notices": "node scripts/notices.mjs",
    "package": "npm run compile && node scripts/pack.mjs",
    "test:package": "node scripts/test-package.mjs",
    "compile": "node scripts/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@napi-rs/keyring": "2.1.0",
    "@opencode-ai/sdk": "1.18.34",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "re2js": "2.8.6",
    "tough-cookie": "5.1.2",
    "undici": "7.30.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "opencode-ai": "1.18.34"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WeiBiran/aladdin-dify-copilot.git"
  },
  "homepage": "https://github.com/WeiBiran/aladdin-dify-copilot#readme",
  "bugs": {
    "url": "https://github.com/WeiBiran/aladdin-dify-copilot/issues"
  },
  "keywords": [
    "dify",
    "fde",
    "opencode",
    "workflow",
    "chatflow",
    "evaluation",
    "harness",
    "web",
    "cli"
  ]
}
